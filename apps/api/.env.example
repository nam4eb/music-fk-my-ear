PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://vibebox:vibebox_dev_password@localhost:5432/vibebox
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SETUP_TOKEN=REPLACE_WITH_PRIVATE_ONE_TIME_SETUP_TOKEN
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=100
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.music-uploads
# Production: STORAGE_DRIVER=r2, fill the following secret values ONLY on the API host:
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=vibebox-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public origin of API, required for local signed links (e.g. https://api.example.com)
API_PUBLIC_URL=http://localhost:4000
