PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://vibebox:vibebox_dev_password@127.0.0.1:5433/vibebox
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# OAuth 2.0 Client ID of type "Web application" from Google Cloud Console
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
# Only this verified Google account can own/access the app
GOOGLE_OWNER_EMAIL=REPLACE_WITH_YOUR_GOOGLE_EMAIL
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=100
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.music-uploads
# Phase 3: set STORAGE_DRIVER=r2 after SQL 003 and R2 probe.
# Existing local tracks keep playing from LOCAL_STORAGE_DIR until migrated.
# These R2 secrets belong ONLY on the API host. Do NOT add NEXT_PUBLIC_ prefix.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=vibebox-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public origin of API, required for local signed links (e.g. https://api.example.com)
API_PUBLIC_URL=http://localhost:4000

# See docs/R2_PHASE3_VI.md before activating production.
