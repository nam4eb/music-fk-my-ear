{
  "name": "@vibebox/api",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:owner": "node --experimental-strip-types --test test/ownerPolicy.test.mjs",
    "r2:check": "node scripts/check-r2.mjs",
    "r2:migrate": "node scripts/migrate-local-to-r2.mjs",
    "test:r2": "node --test scripts/r2MigrationPlan.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@vibebox/core": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "google-auth-library": "^9.15.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
